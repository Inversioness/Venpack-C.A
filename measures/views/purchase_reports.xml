<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- solicitud -->
    <template id="report_purchasequotation_inherit_measures" inherit_id="purchase.report_purchasequotation_document">


        <xpath expr="//t[@t-call='web.external_layout']" position="inside">
            <style>
                .header .row {
                    font-size: 10pt !important;
                }
                
                .header [t-field="company.partner_id"],
                .header .company_address,
                .header div,
                .header span,
                .header p,
                .header li {
                    font-size: 10pt !important;
                    line-height: 1.2 !important;
                }

        
                .page, .address, address, [name="address"] {
                    font-size: 10pt !important;
                }
    
                table, thead, tbody, tr, td, th {
                    font-size: 10pt !important;
                }
            </style>
        </xpath>

        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                </t>
        </xpath>
        
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-value="None"/>
        </xpath>

        <xpath expr="//div[@class='page']/*[1]" position="before">
            <div class="row mb-4" style="font-size: 14px;">
                <div class="col-6">
                    <span t-field="o.partner_id.name"/><br/>
                    <span t-field="o.partner_id.city"/>, <span t-field="o.partner_id.country_id.name"/><br/>
                    <span t-if="o.partner_id.phone"><i class="fa fa-phone"/> <span t-field="o.partner_id.phone"/><br/></span>
                    <strong>N° Identificación fiscal:</strong> <span t-field="o.partner_id.vat"/>
                </div>
                <div class="col-6">
                </div>
            </div>
        </xpath>
    
                
        <xpath expr="//h2" position="after">
            <div class="row mt-2 mb-2" t-if="o.x_tipo">
                <div class="col-6">
                    <strong>Tipo: </strong>
                    <span t-field="o.x_tipo"/>
                </div>
                <div class="col-6">
                    <strong>Responsable:</strong>
                    <span t-field="o.x_studio_responsable"/>
                </div>
            </div>
        </xpath>
        
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th class="text-end"><strong>UdM</strong></th>
            <t t-if="o.x_tipo != '3'">
                <th class="text-end"><strong>Cant. Embalaje</strong></th>
                <th class="text-end"><strong>Embalaje</strong></th>
                <th class="text-end"><strong>Cant. UdMV</strong></th>
                <th class="text-end"><strong>UdMV</strong></th>
                <th class="text-end"><strong>Cant x Embalaje</strong></th>
            </t>
        </xpath>
    
        <xpath expr="//t[@t-if='not order_line.display_type']/td[last()]" position="replace">
            
            <td class="text-end">
                <span t-field="order_line.product_qty"/>
            </td>
            <td class="text-end">
                <span t-esc="''.join([c for c in order_line.product_uom.name if not c.isdecimal() and c not in (',', '.')]).strip()" groups="uom.group_uom"/>
            </td>
            <t t-if="o.x_tipo != '3'">
                <td class="text-end">
                    <span t-field="order_line.product_packaging_qty"/>
                </td>
                <td class="text-end">
                    <span t-field="order_line.product_packaging_id"/>
                </td>
                <td class="text-end">
                    <span t-field="order_line.packaging_qty_info"/>
                </td>
                <td class="text-end">
                    <span t-field="order_line.product_uom_sale"/>
                </td>
                <td class="text-end">
                    <span t-field="order_line.qty_uom"/>
                </td>
            </t>
        </xpath>

        <xpath expr="//table" position="after">
            <div class="row justify-content-end">
                <div class="col-4">
                    <table class="table table-sm">
                        <tr class="border-black">
                            <td><strong>Total Cantidad</strong></td>
                            <td class="text-end">
                                <span t-esc="sum(o.order_line.mapped('product_qty'))" t-options='{"widget": "float", "precision": 2, "decimal_separator": ",", "thousand_separator": "."}'/>
                                <span t-esc="''.join([c for c in order_line.product_uom.name if not c.isdecimal() and c not in (',', '.')]).strip()" groups="uom.group_uom"/>
                            </td>
                        </tr>
                        <t t-if="o.x_tipo != '3'">
                            <tr class="border-black">
                                <td><strong>Total Embalaje</strong></td>
                                <td class="text-end">
                                    <span t-esc="sum(o.order_line.mapped('product_packaging_qty'))" t-options='{"widget": "float", "precision": 2, "decimal_separator": ",", "thousand_separator": "."}'/>
                                    <span t-field="order_line.product_packaging_id"/>
                                </td>
                            </tr>
                            <tr class="border-black o_total">
                                <td><strong>Total Cant Ventas</strong></td>
                                <td class="text-end">
                                    <span t-esc="sum(o.order_line.mapped('qty_uom'))" t-options='{"widget": "float", "precision": 2, "decimal_separator": ",", "thousand_separator": "."}'/>
                                    <span t-field="order_line.product_uom_sale"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

    <!-- orden de compra -->

    <template id="report_purchaseorder_inherit_measures" inherit_id="purchase.report_purchaseorder_document">
        
        <xpath expr="//t[@t-call='web.external_layout']" position="inside">
            <style>
                .header .row {
                    font-size: 10pt !important;
                }
                
                .header [t-field="company.partner_id"],
                .header .company_address,
                .header div,
                .header span,
                .header p,
                .header li {
                    font-size: 10pt !important;
                    line-height: 1.2 !important;
                }

               
        
                .page, .address, address, [name="address"] {
                    font-size: 10pt !important;
                }
    
                table, thead, tbody, tr, td, th {
                    font-size: 10pt !important;
                }
            </style>
        </xpath>

        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                </t>
        </xpath>
        
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-value="None"/>
        </xpath>

        <xpath expr="//div[@class='page']/*[1]" position="before">
            <div class="row mb-4" style="font-size: 14px;">
                <div class="col-6">
                    <span t-field="o.partner_id.name"/><br/>
                    <span t-field="o.partner_id.city"/>, <span t-field="o.partner_id.country_id.name"/><br/>
                    <span t-if="o.partner_id.phone"><i class="fa fa-phone"/> <span t-field="o.partner_id.phone"/><br/></span>
                    <strong>N° Identificación fiscal:</strong> <span t-field="o.partner_id.vat"/>
                </div>
                <div class="col-6">
                </div>
            </div>
        </xpath>
        
        <xpath expr="//div[@id='informations']/div[@t-if='o.user_id']" position="before">
            <div class="col-3 bm-2" t-if="o.x_tipo">
                    <strong>Tipo: </strong>
                    <p t-field="o.x_tipo" class="m-0"/>
            </div>
        </xpath>
        
        <xpath expr="//div[@id='informations']/div[@t-if='o.user_id']" position="replace">
            <div t-if="o.x_studio_responsable" class="col-3 bm-2">
                <strong>Responsable:</strong>
                <p t-field="o.x_studio_responsable" class="m-0"/>
            </div>
        </xpath>
        
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th class="text-end"><strong>UdM</strong></th>
            <t t-if="o.x_tipo != '3'">
                <th class="text-end"><strong>Cant. Embalaje</strong></th>
                <th class="text-end"><strong>Embalaje</strong></th>
                <th class="text-end"><strong>Cant. UdMV</strong></th>
                <th class="text-end"><strong>UdMV</strong></th>
                <th class="text-end"><strong>Cant x Embalaje</strong></th>

            </t>
        </xpath>
        
        <xpath expr="//t[@t-if='not line.display_type']/td[3]" position="replace">
            <td class="text-end">
                <span t-field="line.product_qty"/>
            </td>
            <td class="text-end">
                <span t-esc="''.join([c for c in line.product_uom.name if not c.isdecimal() and c not in (',', '.')]).strip()" groups="uom.group_uom"/>
            </td>
            <t t-if="o.x_tipo != '3'">
                <td class="text-end">
                    <span t-field="line.product_packaging_qty"/>
                </td>
                <td class="text-end">
                    <span t-field="line.product_packaging_id"/>
                </td>
                <td class="text-end">
                    <span t-field="line.packaging_qty_info"/>
                </td>
                <td class="text-end">
                    <span t-field="line.product_uom_sale"/>
                </td>
                <td class="text-end">
                    <span t-field="line.qty_uom"/>
                </td>
            </t>
        </xpath>

        <xpath expr="//div[@id='total']//table" position="inside">
            <tr class="border-black o_total">
                <td><strong>Total Cantidad</strong></td>
                <td class="text-end">
                    <span t-esc="sum(o.order_line.mapped('product_qty'))" t-options='{"widget": "float", "precision": 2, "decimal_separator": ",", "thousand_separator": "."}'/>
                    <span t-esc="''.join([c for c in line.product_uom.name if not c.isdecimal() and c not in (',', '.')]).strip()" groups="uom.group_uom"/>
                </td>
            </tr>
            <t t-if="o.x_tipo != '3'">
                <tr class="border-black o_total">
                    <td><strong>Total Embalaje</strong></td>
                    <td class="text-end">
                        <span t-esc="sum(o.order_line.mapped('product_packaging_qty'))" t-options='{"widget": "float", "precision": 2, "decimal_separator": ",", "thousand_separator": "."}'/>
                        <span t-field="line.product_packaging_id"/>
                    </td>
                </tr>
                <tr class="border-black o_total">
                    <td><strong>Total Cant Ventas</strong></td>
                    <td class="text-end">
                        <span t-esc="sum(o.order_line.mapped('qty_uom'))" t-options='{"widget": "float", "precision": 2, "decimal_separator": ",", "thousand_separator": "."}'/>
                        <span t-field="line.product_uom_sale"/>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>

     <!-- albaran -->

    <template id="report_delivery_document_inherit_signature" inherit_id="stock.report_delivery_document">
    
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <div t-if="o.x_studio_responsable" class="col-auto col-3 mw-100 mb-2" name="div_responsable">
                <strong>Responsable:</strong>
                <p t-field="o.x_studio_responsable" class="m-0"/>
            </div>
        </xpath>
    
        <xpath expr="//div[@class='page']" position="inside">
            <div class="mt-5 border-top" name="custom_signature_block" style="page-break-inside: avoid;">
                <div class="row mt-4">
                    <!--div class="col-6">
                        <strong>Firma del Receptor:</strong>
                        <div class="mt-2" style="border-bottom: 1px solid black; width: 80%; height: 40px;"/>
                        <p class="mt-2">Nombre y C.I.:</p>
                    </div-->
                    <div class="col-6 text-center" t-if="o.x_studio_firma">
                        <strong>Firma Digital:</strong>
                        <div>
                            <img t-att-src="image_data_uri(o.x_studio_firma)" style="max-height: 3cm; max-width: 6cm;"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    
    </template>

    <!-- recoleccion -->

    <template id="report_picking_inherit_signature" inherit_id="stock.report_picking">
    
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <div t-if="o.x_studio_responsable" class="col-auto col-3 mw-100 mb-2" name="div_responsable">
                <strong>Responsable:</strong>
                <p t-field="o.x_studio_responsable" class="m-0"/>
            </div>
        </xpath>
    
        <xpath expr="//div[@class='page']" position="inside">
            <div class="mt-5 border-top" name="custom_picking_signature" style="page-break-inside: avoid;">
                <div class="row mt-4">
                    <!--div class="col-6">
                        <strong>Firma del Almacenista:</strong>
                        <div class="mt-2" style="border-bottom: 1px solid black; width: 80%; height: 40px;"/>
                        <p class="mt-2" t-field="o.x_studio_responsable">Nombre del Responsable</p>
                    </div-->
                    <div class="col-6 text-center" t-if="o.x_studio_firma">
                        <strong>Firma Recibido:</strong>
                        <div>
                            <img t-att-src="image_data_uri(o.x_studio_firma)" style="max-height: 3cm; max-width: 6cm;"/>
                        </div>
                    </div>

                    <div class="col-6 text-center" t-if="o.x_studio_firma_despachado">
                        <strong>Firma Despachado:</strong>
                        <div>
                            <img t-att-src="image_data_uri(o.x_studio_firma_despachado)" style="max-height: 3cm; max-width: 6cm;"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    
    </template>
</odoo>