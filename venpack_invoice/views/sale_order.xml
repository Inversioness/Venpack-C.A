<odoo>
  <data>
     <record id="custom_view_sale_order_form" model="ir.ui.view">
            <field name="name">custom.view.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- <field name="partner_id" position="after">
                    <field name="x_purchase_order"/>
                    <field name="x_payment_method"/>
                </field> -->

                <field name="tag_ids" position="after">
                    <field name="x_totalkd"/>
                    <field name="x_totaluds_despachadas"/>
                </field>

                <xpath expr="//page[@name='other_information']" position="inside">
                  <group string="Datos del Producto" name="product_data">
                    <field name="product_id" readonly="1"/>
                    <field name="x_presentacion" readonly="1"/>
                    <field name="uom_id" readonly="1"/>
                    <field name="x_tipop" readonly="1"/>
                    <field name="x_tipox" readonly="1"/>
                  </group>
                </xpath>

            </field>
        </record>
  </data>
</odoo>