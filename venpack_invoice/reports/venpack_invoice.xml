<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>

        <template id="custom_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <link rel='stylesheet' href="/venpack_invoice/static/src/css/custom_css_reports.css"/>

                        <div class="page" style="font-size: 9pt; font-family: Tahoma, Verdana, Arial, Geneva, Tahoma, sans-serif;">
                            <div class="oe_structure"/>
                            <div class="row">
                                <div class="col-1"/>
                                <br/>
                                <br/>
                                <br/>
                                <div class="col-8">
                                    <div class="row">
                                        <div class="col-8">
                                            <strong>Cliente:</strong>
                                            <span t-field="o.partner_id"/>
                                        </div>
                                        <div class="col-4">
                                            <strong>RIF:</strong>
                                            <span t-field="o.partner_id.vat"/>
                                        </div>
                                    </div>
                                    <strong>Dirección:</strong>
                                    <span t-esc="address"/>
                                    <br/>
                                    <strong>Telefono:</strong>
                                    <span t-field="o.partner_id.phone"/>
                                </div>
                                <div class="col-3 text-center" style="font-size: 14pt; line-height: 130%">
                                    <t t-if="o.x_tipodoc == 'Recibo'">
                                        <stron>
                                            <span>Recibo</span>
                                            <br/>
                                            <span t-field="o.ref"/>
                                        </stron>
                                    </t>
                                    <t t-elif="o.x_tipodoc == 'Nota de Crédito'">
                                        <stron>
                                            <span>NOTA DE CREDITO</span>
                                            <br/>
                                            <span t-field="o.ref"/>
                                        </stron>
                                    </t>
                                    <t t-elif="o.x_tipodoc == 'Nota de Débito'">
                                        <stron>
                                            <span>NOTA DE DEBITO</span>
                                            <br/>
                                            <span t-field="o.ref"/>
                                        </stron>
                                    </t>
                                    <t t-else="">
                                        <stron>
                                            <span>FACTURA</span>
                                            <br/>
                                            <span t-field="o.ref"/>
                                            <br/>
                                            <span style="font-size: 8pt;">
                                                FECHA: <span t-field="o.invoice_date"/>
                                            </span>
                                        </stron>
                                    </t>
                                </div>
                            </div>
                            <div style="line-height: 100%;">
                                <table class="table table-sm table-bordered">
                                    <t t-if="o.x_tipodoc == 'Factura'">
                                        <thead>
                                            <tr>
                                                <th name="th_101" class="text-center"><span>FECHA DE VENCIMIENTO</span></th>
                                                <th name="th_102" class="text-center"><span>CONDICION DE PAGO</span></th>
                                                <th name="th_103" class="text-center"><span>ORDEN DE COMPRA</span></th>
                                                <th name="th_104" class="text-center"><span>NO DE PEDIDO</span></th>
                                                <th name="th_105" class="text-center"><span>GUIA DE DESPACHO</span></th>
                                                <th name="th_106" class="text-center"><span>COD. VENDEDOR</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td name="td_101" class="text-center"><span t-field="o.invoice_date_due"/></td>
                                                <td name="td_102" class="text-center"><span t-field="o.invoice_payment_term_id.name"/></td>
                                                <td name="td_103" class="text-center"><span t-field="o.x_purchase_order"/></td>
                                                <td name="td_104" class="text-center"><span t-field="o.x_npedido"/></td>
                                                <td name="td_105" class="text-center"><span t-field="o.x_dispatch_number_tracking"/></td>
                                                <td name="td_106" class="text-center"/>
                                            </tr>
                                        </tbody>
                                    </t>
                                    <t t-else=" ">
                                        <thead>
                                            <tr>
                                                <th name="th_201" class="text-center"><span>FECHA DOCUMENTO</span></th>
                                                <th name="th_202" class="text-center"><span>FECHA DE VENCIMIENTO</span></th>
                                                <th name="th_203" class="text-center"><span>NUMERO FACTURA AFECTADA</span></th>
                                                <th name="th_204" class="text-center"><span>ORDEN DE COMPRA</span></th>
                                                <th name="th_205" class="text-center"><span>CONDICION DE PAGO</span></th>
                                                <th name="th_206" class="text-center"><span>VENDEDOR</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td name="td_101" class="text-center"><span t-field="o.invoice_date"/></td>
                                                <td name="td_102" class="text-center"><span t-field="o.invoice_date_due"/></td>
                                                <td name="td_103" class="text-center"><span t-field="o.reversed_entry_id.ref"/></td>
                                                <td name="td_104" class="text-center"><span t-field="o.x_purchase_order"/></td>
                                                <td name="td_105" class="text-center"><span t-field="o.invoice_payment_term_id.name"/></td>
                                                <td name="td_106" class="text-center"/>
                                            </tr>
                                        </tbody>
                                    </t>

                                </table>
                            </div>
                            <div style="line-height: 90%;">
                                <table class="table table-sm table-bordered" name="invoice_line_table">
                                    <thead>
                                        <tr>
                                            <t t-if="o.x_tipodoc == 'Factura'">
                                                <th name="th_code" class="text-start"><span>Código</span></th>
                                            </t>
                                            <th name="th_description" class="text-start"><span>Descripción</span></th>
                                            <th name="th_quantity" class="text-start"><span>Cantidad</span></th>
                                            <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Precio Unitario</span></th>
                                            <th name="th_tax" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>IVA</span></th>
                                            <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span>Disc.%</span>
                                            </th>
                                            <th name="th_subtotal" class="text-end">
                                                <t t-if="env.user.has_group('account.group_show_line_subtotals_tax_excluded')">
                                                    <span>Monto</span>
                                                </t>
                                                <t t-elif="env.user.has_group('account.group_show_line_subtotals_tax_included')">
                                                    <span>Precio Total</span>
                                                </t>
                                                <t t-else="">
                                                    <span>Monto</span>
                                                </t>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody class="invoice_tbody">
                                        <t t-set="current_subtotal" t-value="0"/>

                                        <t t-foreach="lines" t-as="line">
                                            <t t-if="env.user.has_group('account.group_show_line_subtotals_tax_excluded')" t-set="current_subtotal" t-value="current_subtotal + line['price_subtotal']"/>
                                            <t t-elif="env.user.has_group('account.group_show_line_subtotals_tax_included')" t-set="current_subtotal" t-value="current_subtotal + line['price_total']"/>
                                            <t t-else="" t-set="current_subtotal" t-value="current_subtotal + line['price_subtotal']"/>

                                            <tr style="max-height:10px;" t-att-class="'bg-200 font-weight-bold o_line_section' if line['display_type'] == 'line_section' else 'font-italic o_line_note' if line['display_type'] == 'line_note' else ''">
                                                <t t-if="line['display_type'] == 'product'" name="account_invoice_line_accountable">
                                                    <t t-if="o.x_tipodoc == 'Factura'">
                                                        <td class="text-start">
                                                            <span t-esc="line['default_code']"/>
                                                        </td>
                                                    </t>
                                                    <td name="account_invoice_line_name"><span t-esc="line['name']" t-options="{'widget': 'text'}"/></td>

                                                    <td class="text-start">
                                                        <span t-esc="line['quantity']" t-options="{'widget': 'float', 'precision': 4}"/>
                                                        <span t-esc="line['product_uom_id']" />
                                                    </td>
                                                    <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                        <span class="text-nowrap" t-esc="line['price_unit_2']"/>
                                                    </td>

                                                    <td name="tax" class="text-end"><span t-options="{'widget': 'text'}">16,00</span></td>
                                                    <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                        <span class="text-nowrap" t-esc="line['discount']"/>
                                                    </td>

                                                    <td class="text-end o_price_total">
                                                        <t t-if="env.user.has_group('account.group_show_line_subtotals_tax_excluded')">
                                                            <span class="text-nowrap" t-esc="line['price_subtotal_2']"/>
                                                        </t>
                                                        <t t-elif="env.user.has_group('account.group_show_line_subtotals_tax_included')">
                                                            <span class="text-nowrap" t-esc="line['price_total_2']"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-nowrap" t-esc="line['price_subtotal_2']"/>
                                                        </t>

                                                    </td>
                                                </t>
                                                <t t-if="line['display_type'] == 'line_section'">
                                                    <td colspan="99">
                                                        <span t-esc="line['name']" t-options="{'widget': 'text'}"/>
                                                    </td>
                                                    <t t-set="current_section" t-value="line"/>
                                                    <t t-set="current_subtotal" t-value="0"/>
                                                </t>
                                                <t t-if="line['display_type'] == 'line_note'">
                                                    <td colspan="99">
                                                        <span t-esc="line['name']" t-options="{'widget': 'text'}"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="row" style="line-height: 120%">
                                <!-- <div class="col-4 custom_div_padding_right">
                                    <t t-if="o.x_tipodoc == 'Factura'">
                                        <div style="font-size: 9pt;">
                                            <t t-set="total_currency_amount" t-value="o.amount_untaxed / o.x_tasa"/>
                                            <p> ESTA FACTURA REPRESENTA U$D <span t-esc="total_currency_amount" t-options='{"widget": "float", "precision": 2}'/> A TASA BCV BsD. <span t-field="o.x_tasa" t-options='{"widget": "float", "precision": 2}'/> FECHA <span t-field="o.invoice_date"/> CONFORME A LO ESTABLECIDO EN EL ART. 25 DE LA LEY DE IVA Y ART. 13 No 14 PROVIDENCIA 0071</p>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <t t-if="o.x_tipodoc == 'Nota de Débito'">
                                            <span>TASA BCV </span>
                                            <span t-field="o.x_tasa"/>
                                            <span> FECHA </span>
                                            <span t-field="o.invoice_date"/>
                                            <br/>
                                            <br/>
                                        </t>
                                        <span>TOTAL FACTURA BsD </span>
                                        <span t-field="o.reversed_entry_id.amount_total"/>
                                        <span>// FECHA </span>
                                        <span t-field="o.reversed_entry_id.invoice_date"/>
                                    </t>
                                </div> -->
                                <div class="col-5" style="font-size: 8pt;">
                                    <t t-if="o.x_tipodoc == 'Factura'">
                                        <div style="text-align: justify;">
                                            <span>
                                                Si la cancelación de esta factura se realiza en divisas en efectivo, transferencias o depósitos en bancos en el exterior se debe adicionar el 3% del IGTF, de acuerdo a lo establecido en la G.O. 42.339 del 17/03/2022
                                            </span>
                                            <br/>
                                            <span>Tasa Oficial BCV: </span>
                                            <span t-field="o.x_tasa" t-options='{"widget": "float", "precision": 4}'/>
                                            <span> FECHA: </span>
                                            <span t-field="o.invoice_date"/>
                                            <br/>
                                            <span>CONFORME A LO ESTABLECIDO EN EL ARTÍCULO 25 DE LA LEY DEL IVA Y EL ARTÍCULO 13 NUMERAL 14 DE LA PROVIDENCIA 0071.</span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div style="line-height: 150%;">
                                            <span><strong>N° Documento afectado: </strong><span t-field="o.reversed_entry_id.ref"/></span>
                                            <span style="margin-left: 8px;"><strong>Fecha Doc.: </strong><span t-field="o.reversed_entry_id.create_date" t-options="{'widget': 'date'}"/></span>
                                            <br/>
                                            <span><strong>Base imponible: </strong><span t-field="o.reversed_entry_id.amount_untaxed"/></span>
                                            <span style="margin-left: 8px;"><strong>Impuesto IVA 16%: </strong><span t-field="o.reversed_entry_id.amount_tax"/></span>
                                            <br/>
                                            <strong>Total: </strong><span t-field="o.reversed_entry_id.amount_total"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="col-1"></div>
                                <div class="col-6 custom_div_padding_left">
                                    <div class="clearfix">
                                        <div id="total" class="row">
                                            <t t-set="currency_usd" t-value="request.env['res.currency'].search([('name','=','USD')], limit=1)"/>
                                            <t t-set="currency_ves" t-value="request.env['res.currency'].search([('name','=','VES')], limit=1)"/>
                                            <table class="table table-sm" style="page-break-inside: avoid; line-height: 100%">
                                                
                                                <!--Tax totals-->
                                                <!-- <t t-if="o.currency_id.name == 'VES'">
                                                    <t t-set="amount_untaxed_usd" t-value="amount_untaxed/o.x_tasa if o.x_tasa else 0"/>
                                                    <t t-set="discount_sum_usd" t-value="discount_sum/o.x_tasa if o.x_tasa else 0"/>
                                                    <t t-set="tax_iva_usd" t-value="tax_iva/o.x_tasa if o.x_tasa else 0"/>
                                                    <t t-set="amount_total_usd" t-value="o.amount_total/o.x_tasa if o.x_tasa else 0"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="amount_untaxed_bs" t-value="amount_untaxed * o.x_tasa if o.x_tasa else 0"/>
                                                    <t t-set="discount_sum_bs" t-value="discount_sum * o.x_tasa if o.x_tasa else 0"/>
                                                    <t t-set="tax_iva_bs" t-value="tax_iva * o.x_tasa if o.x_tasa else 0"/>
                                                    <t t-set="amount_total_bs" t-value="o.amount_total * o.x_tasa if o.x_tasa else 0"/>
                                                </t> -->

                                                <tr class="border-black o_subtotal">
                                                    <td><strong style="line-height: 100%">Base Imponible</strong></td>
                                                    <td class="text-end">
                                                        <span t-esc="amount_untaxed_ves" t-options="{'widget': 'monetary', 'display_currency': currency_ves}"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="amount_untaxed_rate" t-options="{'widget': 'monetary', 'display_currency': currency_usd}"/>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td><strong style="line-height: 100%">Descuento</strong></td>
                                                    <td class="text-end">
                                                        <span t-esc="discount_sum_ves" t-options="{'widget': 'monetary', 'display_currency': currency_ves}"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="discount_sum_rate" t-options="{'widget': 'monetary', 'display_currency': currency_usd}"/>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td><strong style="line-height: 100%">Total a IVA 16%</strong></td>
                                                    <td class="text-end">
                                                        <span t-esc="tax_iva_ves" t-options="{'widget': 'monetary', 'display_currency': currency_ves}"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="tax_iva_rate" t-options="{'widget': 'monetary', 'display_currency': currency_usd}"/>
                                                    </td>
                                                </tr>

                                                <tr class="border-black o_total">
                                                    <td><strong style="line-height: 100%">Total a Pagar</strong></td>
                                                    <td class="text-end">
                                                        <span t-esc="amount_total_ves" t-options="{'widget': 'monetary', 'display_currency': currency_ves}"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="amount_total_rate" t-options="{'widget': 'monetary', 'display_currency': currency_usd}"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="line-height: 120%">
                                <div style="width:40%">
                                    <div class="text-center" style="font-size: 9pt;">
                                        <hr style="width:100%; text-align:center;" color="black"/>
                                        <span>RECIBIDO CLIENTE</span>
                                        <br/>
                                        <span>ESTE DOCUMENTO VA SIN TACHADURA NI ENMIENDAS</span>
                                    </div>
                                </div>
                                <div style="width:10%"/>
                                <div style="width:50%; font-size: 8pt;">
                                    <span>a) Para todos los efectos la compañía se reserva el derecho de elegir domicilio especial.</span>
                                    <br/>
                                    <span>b) Vencido el plazo cedido se cobraran intereses a razón de la tasa actual</span>
                                </div>
                            </div>
                            <!-- <div class="text-end" style="font-size: 9pt;">
                                <span t-field="o.x_ncontrol"/>
                            </div> -->
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>