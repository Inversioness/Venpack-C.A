<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>

        <template id="custom_document_tax_totals">
            <!--
                Generic template to display tax totals in pdf reports.
                Used by invoices, SO and PO.

                ARGUMENTS:
                - tax_totals: dict in the form generated by account.move's _get_tax_totals.
            -->
            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                <tr class="border-black o_subtotal">
                    <td><strong t-esc="subtotal['name']"/></td>

                    <td class="text-end">
                        <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                                
                            <t t-set="formatted_amount" t-value="float(subtotal['amount']) * doc.x_tasav"/>
                            <span
                                t-att-class="oe_subtotal_footer_separator"
                                t-esc="formatted_amount"
                                t-options='{"widget": "monetary", "display_currency": currency_obj}'
                            />
                        </t>
                        <t t-else="">
                            <span
                                t-att-class="oe_subtotal_footer_separator"
                                t-esc="subtotal['formatted_amount']"
                            />
                        </t>
                    </td>
                </tr>

                <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                <!-- <t t-call="account.tax_groups_totals"/> -->
                <t t-call="venpack_invoice.custom_tax_groups_totals"/>
            </t>

            <t t-set="has_rounding" t-value="'formatted_amount_total_rounded' in tax_totals"/>
            <!--Total amount with all taxes-->
            <tr class="border-black o_total">
                <t t-if="has_rounding"><td>Total</td></t>
                <t t-else=""><td><strong>Total</strong></td></t>
                <td class="text-end">
                    <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                        <t t-set="amount_total" t-value="float(tax_totals['amount_total']) * doc.x_tasav"/>
                        <span t-esc="amount_total" t-options='{"widget": "monetary", "display_currency": currency_obj}'/>
                    </t>
                    <t t-else="">
                        <span t-esc="tax_totals['formatted_amount_total']"/>
                    </t>
                </td>
            </tr>
            <tr t-if="has_rounding">
                <td><strong>Total Rounded</strong></td>
                <td class="text-end">
                    <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                        <t t-set="amount_total_rounded" t-value="float(tax_totals['amount_total_rounded']) * doc.x_tasav"/>
                        <td class="text-right">
                            <span t-esc="amount_total_rounded" t-options='{"widget": "monetary", "display_currency": currency_obj}'/>
                        </td>
                    </t>
                    <t t-else="">
                        <span t-esc="tax_totals['formatted_amount_total_rounded']"/>
                    </t>
                </td>
            </tr>
        </template>

        <template id="custom_tax_groups_totals">
            <!--
                Generic template to display a list of tax groups with the related amounts.

                ARGUMENTS:
                - tax_totals: dict in the form generated by account.move's _get_tax_totals.
                - subtotal_to_show: The subtotal we need to render the groups from
            -->
            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]" t-as="amount_by_group">
                <tr>
                    <t t-if="tax_totals['display_tax_base']">
                        <td>
                            <span t-esc="amount_by_group['tax_group_name']"/>

                            <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                                <t t-set="tax_group_base_amount" t-value="float(amount_by_group['tax_group_base_amount']) * doc.x_tasav"/>
                                <span class="text-nowrap"> on
                                    <t t-esc="tax_group_base_amount" t-options='{"widget": "monetary", "display_currency": currency_obj}'/>
                                </span>
                            </t>
                            <t t-else="">
                                <span class="text-nowrap"> on
                                    <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                                </span>
                            </t>
                        </td>
                        <td class="text-end o_price_total">
                            <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                                <t t-set="tax_group_amount" t-value="float(amount_by_group['tax_group_amount']) * doc.x_tasav"/>
                                <span class="text-nowrap" t-esc="tax_group_amount" t-options='{"widget": "monetary", "display_currency": currency_obj}'/>
                            </t>
                            <t t-else="">
                                <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                            </t>
                            
                        </td>
                    </t>
                    <t t-else="">

                        <td><span class="text-nowrap" t-esc="amount_by_group['tax_group_name']"/></td>
                        <t t-if="doc.pricelist_id.currency_id.name != 'VES'">   
                            <t t-set="tax_group_amount" t-value="float(amount_by_group['tax_group_amount']) * doc.x_tasav"/>
                            <td class="text-end o_price_total">
                                <span class="text-nowrap" t-esc="tax_group_amount" t-options='{"widget": "monetary", "display_currency": currency_obj}'/>
                            </td>
                        </t>
                        <t t-else="">
                            <td class="text-end o_price_total">
                                <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']" />
                            </td>
                        </t>
                    </t>
                </tr>
            </t>
        </template>

        <template id="report_saleorder_document_inherit_exchange_rate_quotes" inherit_id="sale.report_saleorder_document">

            <xpath expr="//div[@class='page']//h2" position="before">
                <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                    <t t-set="currency" t-value="'Bs'"/>
                    <t t-set="currency_obj" t-value="request.env['res.currency'].search([('name', '=', 'VES')])"/>
                </t>
            </xpath>

            <xpath expr="//td[@name='td_priceunit']" position="replace">
                <td name="td_priceunit" class="text-end">
                    <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                        <t t-set="price_unit" t-value="line.price_unit * doc.x_tasav"/>
                        <span t-esc="price_unit" t-options='{"widget": "float", "precision": 2}'/>
                    </t>
                    <t t-else="">
                        <span t-field="line.price_unit"/>
                    </t>
                </td>
            </xpath>

            <xpath expr="//td[@name='td_subtotal']" position="replace">
                <td name="td_subtotal" class="text-end o_price_total">
                    <t t-if="doc.pricelist_id.currency_id.name != 'VES'">
                        <t t-set="price_subtotal" t-value="line.price_subtotal * doc.x_tasav"/>
                        <t t-set="price_total" t-value="line.price_total * doc.x_tasav"/>
                    
                        <span t-esc="price_subtotal" t-options='{"widget": "monetary", "display_currency": currency_obj}'/>
                        <!-- <span t-esc="price_subtotal" t-options='{"widget": "monetary", "display_currency": currency_obj}' groups="account.group_show_line_subtotals_tax_excluded"/> -->
                        <!-- <span t-esc="price_total" t-options='{"widget": "monetary", "display_currency": currency_obj}' groups="account.group_show_line_subtotals_tax_included"/> -->
                    </t>
                    <t t-else="">
                        <span t-field="line.price_subtotal"/>
                        <!-- <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/> -->
                        <!-- <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/> -->
                    </t>
                </td>
            </xpath>

            <xpath expr="//div[@name='so_total_summary']" position="replace">
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row" name="total">

                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="table table-sm">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-call="venpack_invoice.custom_document_tax_totals"/>
                            </table>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>
    </data>
</odoo>