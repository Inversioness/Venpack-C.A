<odoo>
    <record id="product_template_form_view_inherit_promedio" model="ir.ui.view">
        <field name="name">product.template.form.inherit.promedio</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="promedio_usd" string="Costo USD" readonly="promedio_usd > 0" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>