<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blank_tax_report_wizard_form" model="ir.ui.view">
        <field name="name">blank.tax.report.wizard.form</field>
        <field name="model">blank.tax.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte de Impuestos">
                <group>
                    <field name="report_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button string="Generar" type="object" name="generate_report" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_blank_tax_report_wizard" model="ir.actions.act_window">
        <field name="name">Generar Reporte de Impuestos</field>
        <field name="res_model">blank.tax.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        name="Generar Reporte de Impuestos en Blanco"
        id="menu_blank_tax_report_wizard"
        parent="tax_report.books"
        action="action_blank_tax_report_wizard"
        sequence="20"/>
</odoo>
