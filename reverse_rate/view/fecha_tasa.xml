<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_manual_rate" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.manual.rate</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="manual_currency_rate_active" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='journal_id']" position="after">
                 <field name="manual_rate_date" 
                        string="Fecha de Tasa Manual"
                        invisible="not manual_currency_rate_active"
                        required="manual_currency_rate_active"/>
            </xpath>
        </field>
    </record>
</odoo>