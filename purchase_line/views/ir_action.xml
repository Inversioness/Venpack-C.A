<odoo>
  <data>
    <record id="action_reporte_lineas_compra" model="ir.actions.act_window">
        <field name="name">Reporte Líneas de Compra</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form,graph</field>

        <field name="domain">[
            ('move_type', 'in', ('in_invoice', 'in_refund')),
            ('invoice_origin', '!=', False),
            ('state', '=', 'posted')
        ]</field>

        <field name="context">{
            'default_move_type': 'in_invoice', 
            'move_type': 'in_invoice', 
            'journal_type': 'purchase'
        }</field>
    </record>

    <menuitem 
        id="menu_reporte_lineas_compra" 
        name="Reporte Líneas de Compra" 
        parent="tax_report.books"  action="action_reporte_lineas_compra" 
        sequence="4"  groups="account.group_account_user"
    />
    
    </data>
</odoo>