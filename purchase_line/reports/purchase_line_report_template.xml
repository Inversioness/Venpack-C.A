<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchase_line_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                    
                    <div class="page">

                        <div class="text-center">
                            <h2>Reporte de Líneas de Compra Seleccionadas</h2>
                            <h4>Generado el: </h4>
                        </div>
                        
                        <table class="table table-sm mt-4" style="font-size: 13px;">
                            <thead>
                                <tr>
                                    <th>Núm. Orden</th>
                                    <th>Proveedor</th>
                                    <th>Referencia</th>
                                    <th>Fecha Orden</th>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th class="text-right">Cantidad</th>
                                    <th>UdM</th>
                                    <th class="text-right">Precio Unit. VES</th>
                                    <th class="text-right">Subtotal VES</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="purchase_lines_register" t-as="line">
                                    <tr>
                                        <td><span t-esc="line['Nro de Pedido']"/></td>
                                        <td><span t-esc="line['Proveedor']"/></td>
                                        <td><span t-esc="line['Referencia']"/></td>
                                        <td><span t-esc="line['Fecha Pedido']"/></td>
                                        <td><span t-esc="line['Cod Producto']"/></td>
                                        <td><span t-esc="line['Desc Producto']"/></td>
                                        <td class="text-right"><span t-esc="line['Cantidad']" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td><span t-esc="line['UdM']"/></td>
                                        <td class="text-right"><span t-esc="line['Precio Unit. VES']" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-right"><span t-esc="line['Subtotal VES']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot style="border-top: 2px solid black;">
                                <tr>
                                    <td colspan="6" class="text-right"><strong>TOTALES:</strong></td>
                                    <td class="text-right">
                                        <strong><span t-esc="sum_cantidad" t-options='{"widget": "float", "precision": 2}'/></strong>
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-right">
                                        <strong><span t-esc="sum_subtotal_ves" t-options='{"widget": "float", "precision": 2}'/> Bs</strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                
            </t>
        </t>
    </template>
    
</odoo>