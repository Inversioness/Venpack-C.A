<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_balance_mes_clean">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-size: 12px; font-family: sans-serif; background: transparent !important; border: none !important;">
                    

                    <div class="text-center mb-3" style="border: none !important;">
                        <h5 style="margin: 0; font-weight: bold; color: #444;">
                                <t t-esc="res_company.name"/>
                        </h5>
                        <h5 style="font-weight: bold; letter-spacing: 1px; margin-bottom: 3px;">LIBRO DIARIO</h5>
                        <p class="text-muted" style="font-size: 12px; margin: 0;">
                            <strong>Periodo:</strong> <t t-esc="context_month"/>
                        </p>
                    </div>
                    
                    <table style="font-size: 11px; width: 100%; margin: 0 !important; padding: 0 !important; border: 0 none transparent !important; border-collapse: collapse !important; background: transparent !important;">
                        <thead>
                            <tr style="background: transparent !important; border: 0 none transparent !important;">
                                <th style="width: 60%; border: 0 none transparent !important; padding-bottom: 8px; font-weight: bold; color: #000;">Nombre de la Cuenta</th>
                                <th class="text-end" style="width: 20%; padding-right: 0px; border: 0 none transparent !important; padding-bottom: 8px; font-weight: bold; color: #000;">Débito</th>
                                <th class="text-end" style="width: 20%; padding-right: 0px; border: 0 none transparent !important; padding-bottom: 8px; font-weight: bold; color: #000;">Crédito</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_debe" t-value="0.0"/>
                            <t t-set="total_haber" t-value="0.0"/>

                            <t t-foreach="lines" t-as="line">
                                <tr style="background: transparent !important; border: 0 none transparent !important;">
                                    <td style="border: 0 none transparent !important; padding-top: 5px; padding-bottom: 5px; color: #333;">
                                        <span t-esc="line['name']"/>
                                    </td>
                                    <td class="text-end" style="padding-right: 0px; border: 0 none transparent !important; padding-top: 5px; padding-bottom: 5px; color: #333;">
                                        <span t-esc="None if line['debe'] == 0.0 else '{:,.2f}'.format(line['debe']).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                        <span t-if="line['debe'] == 0.0">0,00</span>
                                    </td>
                                    <td class="text-end" style="padding-right: 0px; border: 0 none transparent !important; padding-top: 5px; padding-bottom: 5px; color: #333;">
                                        <span t-esc="None if line['haber'] == 0.0 else '{:,.2f}'.format(line['haber']).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                        <span t-if="line['haber'] == 0.0">0,00</span>
                                    </td>
                                </tr>
                                <t t-set="total_debe" t-value="total_debe + (line['debe'] or 0.0)"/>
                                <t t-set="total_haber" t-value="total_haber + (line['haber'] or 0.0)"/>
                            </t>

                            <tr style="font-weight: bold; font-size: 11.5px; background: transparent !important; border: 0 none transparent !important;">
                                <td style="border: 0 none transparent !important; padding-top: 15px;"><span>TOTALES</span></td>
                                <td class="text-end" style="padding-right: 0px; border: 0 none transparent !important; padding-top: 15px;">
                                    <span t-esc="'{:,.2f}'.format(total_debe).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                </td>
                                <td class="text-end" style="padding-right: 0px; border: 0 none transparent !important; padding-top: 15px;">
                                    <span t-esc="'{:,.2f}'.format(total_haber).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_balance_mes_clean" model="report.paperformat">
        <field name="name">Formato Balance Líneas Limpias (Márgenes Especiales)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">20</field>
        <field name="margin_right">30</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_balance_mes" model="ir.actions.report">
        <field name="name">Libro Diario</field>
        <field name="model">account.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_line.report_balance_mes_clean</field>
        <field name="report_file">purchase_line.report_balance_mes_clean</field>
        <field name="binding_model_id" ref="account_reports.model_account_report"/>
        <field name="paperformat_id" ref="paperformat_balance_mes_clean"/>
    </record>
</odoo>